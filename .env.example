# 复制为 .env 并填写。不要提交 .env 到 git。
# 改完 .env 不用重启：CLI 里 /refresh 会热重载（force 重读本文件）。

# --- DeepSeek（必填，否则回复为 stub） ---
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash  # 默认 DeepSeek-V4.1-Flash（1M 上下文，全量读的前提）
# DEEPSEEK_EFFORT=low            # 旧键（向后兼容）；v0.102 起用下面的通用键
# LLM_REASONING_EFFORT=low       # 思考强度（跨供应商：DeepSeek=effort low/high/max、Kimi/OpenAI 等=reasoning_effort）
# CHAT_TEMPERATURE=0.8           # 聊天层温度（说话随机性）。网页端「模型设置」可改

# --- 用户称呼兜底（AI 对"你"的称呼） ---
# 优先级：事实便签"叫我X" > profile 清单"称呼"字段 > 这里的 USER_NAME
# 每个朋友可以有个性称呼，一般不用改这里
# USER_NAME=小徐

# --- 企业微信自建应用（备用通道，自用阶段不再是主载体） ---
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENTID=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_USER_ID=

# --- Telegram 兜底通道（telegram 模式必填） ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 像人一样回消息（阅读模拟 + 分段连发 + 正在输入） ---
# READING_SECONDS_PER_CHAR=0.12   # 每字假装阅读时长
# READING_MAX_SECONDS=20          # 阅读等待上限
# SEND_SECONDS_PER_CHAR=0.08      # 分段连发间隔（按上一条长度）
# SEND_MIN_SECONDS=0.6
# SEND_MAX_SECONDS=5
# TYPING_ENABLED=on               # "正在输入"总开关
# TYPING_SECONDS_PER_CHAR=0.12
# TYPING_MIN_SECONDS=1.2
# TYPING_MAX_SECONDS=8

# --- 行为参数 ---
# GUARD_ENABLED=off               # 防打扰总开关（也可运行时 /guard on）
# AUTO_FAMILIAR_INFO_THRESHOLD=5  # 信息攒够多少条自动转"熟悉"
# DAILY_PROACTIVE_LIMIT=6         # 每日主动消息上限
# QUIET_AFTER_BUSY_HOURS=3        # 对方说"在忙"后的静默时长
# MAX_UNANSWERED_PROACTIVE=2      # 连续未回复主动消息上限
# CONTEXT_TURNS=10                # 对话上下文轮数
# PROACTIVE_CONTEXT_TURNS=6       # 主动消息带几条最近聊天

# --- 作息（24 小时制；有人格卡时以人格卡作息为准，这里只作无人格卡的兜底） ---
# WAKE_HOUR=8
# SLEEP_HOUR=23
# NOON_HOUR=12                   # 只驱动 life 的「午休涌现」，不再驱动任何主动消息（v0.103）

# --- 初见阶段（relationship_stage = new）的冒泡策略 ---
# BUBBLE_IDLE_MIN_MINUTES=30      # 空闲多久开始想冒泡
# BUBBLE_IDLE_MAX_MINUTES=60
# BUBBLE_DAILY_LIMIT=12           # 冒泡独立额度，不占主动消息上限
# BUBBLE_FIXED_PROB=0.35          # 冒泡直接抽固定语料的概率（省 token）

# --- 分享冲动（v0.103 念头驱动：素材产出即冲动；v0.104 废掉日预算，改概率+间隔） ---
# SHARE_IMPULSE_ENABLED=on
# SHARE_IMPULSE_OPEN_PROB=0.5     # 有冲动时真开口的概率（不中只是这次忍住了，念头不丢）
# SHARE_IMPULSE_MIN_INTERVAL_MINUTES=60   # 两次冲动开口的最小间隔（防连发）

# --- 日历（v0.103 念头驱动；v0.104 触点概率递增 + 聊过沉淀不取消） ---
# CALENDAR_ENABLED=on
# CALENDAR_TOUCH_PROB_FAR=0.15    # 离事一周时的提起概率
# CALENDAR_TOUCH_PROB_NEAR=0.8    # 到那天时的提起概率（中间按剩余时间插值）
# CALENDAR_TALKED_MUTE_DAYS=2     # 聊过之后几天不靠触点开口（念头/回忆照常）
# CALENDAR_NOTE_MAX=3             # 一件事最多留几条「聊到过」的动态记录

# --- 娱乐（游戏）：不再是模式，规则活在意识流里 ---
# GAME_IDLE_EXPIRE_MINUTES=45     # 游戏空闲多久自动过期（防陈年规则一直挂着）

# --- 每日回顾 + 日记 ---
# DIARY_ENABLED=on
# PURGE_REVIEWED_MESSAGES=off     # on = 复盘写日记后清掉当日原始对话

# --- 记忆主动检索（function calling） ---
# MEMORY_TOOLS_ENABLED=on         # 对方要求回忆时才让 AI 自己翻记忆
# MEMORY_TOOL_MAX_ROUNDS=3        # 一轮回复里工具调用循环的最大轮数

# --- 语义化召回（S4 首位：本地向量 bge-small-zh-v1.5，治"几点睡召不回熬夜"） ---
# 本地跑，数据不出本机；模型文件在 models/（不进 git，首次由 sync-to-server.sh 下载）
# EMBEDDING_ENABLED=on            # 总开关（关了就退回纯字面 bigram 召回）
# EMBEDDING_MODEL_DIR=models/bge-small-zh-v1.5   # ONNX 模型目录（model.onnx + tokenizer.json）
# EMBEDDING_SEMANTIC_WEIGHT=4.0   # 语义相似分在混合打分里的权重（字面 bigram 仍占 2.0）
# EMBEDDING_MIN_SIMILARITY=0.35   # 余弦相似度下限（低于此值不算语义命中，防噪声）

# --- 艾宾浩斯记忆衰减（S4：遗忘 = 一次次总结；被想起越多，记得越久） ---
# 挂在睡前复盘里跑，一天一次、一次批量 LLM 调用；也可 /decay 手动、/decay dry 预览。
# MEMORY_DECAY_ENABLED=on        # 总开关（关了记忆只增不减）
# MEMORY_DECAY_IDLE_DAYS=30      # 多久没被想起 → 淡忘一级（基准天数）
# MEMORY_DECAY_RECALL_BONUS=0.5  # 每被想起一次，有效期加成（有效期=基准×(1+召回次数×本值)）
# MEMORY_DECAY_MAX_LEVEL=3       # 压到第几级彻底遗忘（删行；0=原文）
# MEMORY_DECAY_PIN_RECALLS=8     # 被想起够多次 → 永久记住，不再衰减
# MEMORY_DECAY_BATCH=6           # 一次遗忘最多处理几条
# TODAY_NOTES_ENABLED=on         # 今天做过/读到的事注入当天上下文（跨天自动不注入）
# TODAY_NOTES_MAX=3              # 最多注入几条今日素材
# TODAY_NOTES_CHARS=200          # 每条正文注入截断字数（B 库存全文）

# --- 生活引擎（v0.90：原「工作系统」重写为 life.py；工作=读书，节奏=章节边界） ---
# 排班跟着人格作息走（夜猫子不会在早上被排活）；关掉它就没有"手头的事"，
# 打断成本也无从算起。/work 看它今天读到哪了，/status 也带一行。
# ⚠️ 节奏不是"上班下班"：读到下一个章节边界算一段，读完一章歇一会，
#    唯一硬边界是睡前（没读完不加班补，明天按字数重圈）。
# WORK_ENABLED=on
# WORK_WARMUP_MIN=50              # 醒来后磨蹭多久才开始读（带抖动）
# LUNCH_MIN=120                   # 跨过中午的那次休息至少多长（午休是涌现的，不排班）
# LATE_READ_HOUR=20               # 这之后还在读 = 今天读得晚（叙事事件，不是加班机制）
# WORK_FLOW_RATIO=0.2             # 一段会话前 20% 是心流期（打断代价最高）
# WORK_ENERGY_MAX=100             # 精力上限
# WORK_ENERGY_COST=12             # 每 40 分钟消耗多少精力（换算成每分钟率）
# WORK_ENERGY_RECOVER=8           # 每 20 分钟恢复多少精力（换算成每分钟率）
# WORK_ENERGY_REST_BELOW=40       # 精力低于此值 → 下次休息延长到回血（休息策略吃精力）
# WORK_SHAREABLE_ENABLED=on       # 读到打动的地方产出可分享素材（供主动分享当内容源）
# ⚠️ 已随 v0.90 退役（写了也没用）：WORK_DAILY_QUOTA / WORK_UNIT_MINUTES /
#    WORK_BREAK_MINUTES / WORK_PAY_PER_UNIT（"余额"改「经验」= 读书进度%）/
#    WORK_READ_PER_UNIT / READING_ENABLED / SCHED_* 整族（上课作息 8 半节 → 章节会话）

# --- 打断成本（S3 招牌：它忙不忙/累不累 → 现在找它的代价 costIndex = R×(1+F)） ---
# R 由 phase 给的阻力（心流期最高），F 由精力推的疲劳（越低越累）。
# costIndex < WELCOMED_MAX = 欢迎；< TOLERATED_MAX = 可以；否则 = 有代价（回复短慢）。
# COST_R_FLOW=1.0                 # 心流期阻力（打断最伤）
# COST_R_WORKING=0.7              # 忙自己的事
# COST_R_IDLE=0.3                 # 还没开工
# COST_R_BREAK=0.3                # 歇会儿
# COST_R_OFF=0.0                  # 忙完了（完全欢迎）
# COST_WELCOMED_MAX=0.4
# COST_TOLERATED_MAX=0.9

# --- 紧急通道（打断成本的安全阀） ---
# URGENT_WINDOW_MINUTES=10        # 识别到"有急事"后随叫随到的窗口（过了就恢复常态）

# --- 情绪状态（D 模块，10-09 解冻：HUD「心情」维度） ---
# 心情由它自己的生活推（工作状态 + 精力 + 时段），不是 phase/打断成本的翻版，也不围绕任何人转。
# MOOD_ENABLED=on                 # 心情维度总开关
# MOOD_TIRED_ENERGY=30            # 精力 ≤ 此值 = 疲惫（累是最强烈的感受，盖过其它）
# MOOD_EVENING_HOUR=21            # 这之后忙完 = 平静（夜里自然沉下来）

# --- 人格重量（10-10 人格优化：内核 + 反谄媚 + 双层生成 + 自我记忆） ---
# 背景：旧人格只是一段形容词（"活泼、喜欢科幻"），形容词永远不会被违反 → 约束不了任何一句话，
# 再叠上模型自带的讨好先验 → 谁在跟它说话它就变成谁的形状。这一组把它换成"具体到能被违反的判断"。
# PERSONA_KERNEL_ENABLED=on       # 结构化人格内核注入（好恶/立场/雷区/语言指纹）——旧卡按 archetype 自动补一份
# ANTI_SYCOPHANCY_ENABLED=on      # 反谄媚五条硬规矩（镜像预算/异议配额/禁投降/话题主权/回复自主权）
# INNER_MONOLOGUE_ENABLED=on      # 双层生成：先跑一层看不见的内心独白把立场定住，再说出来（多一次 LLM 调用）
# INNER_MONOLOGUE_TEMPERATURE=0.75  # 独白层温度（比说话层低：要判断，不要表演）
# INNER_MONOLOGUE_MAX_TOKENS=400  # 独白输出上限（很短，额外成本有限）
# UTTERANCE_TEMPERATURE=0.95      # 说话层温度（要高：口语的随机性）
# SELF_MEMORY_ENABLED=on          # 自我记忆（我说过的立场/答应过的事/出过的糗）——不参与艾宾浩斯遗忘
# SELF_MEMORY_MAX=5               # 每轮最多注入几条"关于我自己"的记忆
# SELF_REVIEW_ENABLED=on          # 睡前自我复盘（一天一次，写回自我记忆 + 内部状态）

# --- 自我意识流（S4「完全自我意识」：一条持续追加的第一人称自我叙事） ---
# CONSCIOUS_STREAM_ENABLED=on     # 总开关（关了不追加、不注入意识流）
# CONSCIOUS_STREAM_RECENT=4       # 每轮注入最近几条流
# CONSCIOUS_STREAM_LINE_CHARS=60  # 注入时每行截断字数（独白/回复存全文，注入只看摘要量）

# --- 世界观（§1 架空设定：外来者困在程序里、靠读书成长） ---
# LORE_ENABLED=on                 # 总开关（关了不注入来历骨架 + canon 设定集）

# --- 信息获取（v0.94：把「刷手机看信息」从名词变成动词） ---
# 外部源（RSS/Atom/网页）+ 对话里按需查证。默认源种子在 sources.py 的 DEFAULT_SOURCES；
# 想改订阅源用 /browse src（或网页端「它刷到的」面板），本机改 sources.txt、不进 git。
# BROWSE_ENABLED=on               # 自主刷信息总开关（关掉 = 回归旧行为）
# BROWSE_DAILY_PASSES=2           # 一天刷几次（接作息后生效）
# BROWSE_ITEMS_PER_PASS=3         # 单个源一次最多取几条
# BROWSE_CONTEXT_MAX=2            # 每轮最多注入几条刷到的
# BROWSE_ITEM_CHARS=160           # 每条注入截断字数
# INTEREST_CONVO_DAYS=3           # 刷源兴趣判据：回溯最近几个生活日的双方消息（批 3）
# SOURCE_MAX_CHARS=6000           # 正文参与摘要前的截断
# HTTP_TIMEOUT_SEC=8              # 外部请求超时（超时当没刷到）
# HTTP_CACHE_TTL_MIN=1440         # 同一 URL 多久内不重复抓（分钟）
# INFO_ITEMS_KEEP_DAYS=90         # 刷到的东西保留多少天
# LOOKUP_ENABLED=on               # 对话里按需查证总开关（未落地前无效果）
# LOOKUP_MAX_PER_REPLY=1          # 每轮回复最多几次网络取数
# LOOKUP_DAILY_LIMIT=20           # 每日网络取数上限
# TOOL_RESULT_CHARS=1200          # 工具返回给模型的文本上限
# SEARCH_PROVIDER=none            # 搜索适配器；none = 只用 RSS/网页

# --- 网页端 Web UI（自用阶段主载体：python main.py web） ---
# WEB_HOST=127.0.0.1              # 默认只本机访问；改成 0.0.0.0 会暴露到局域网，慎用
# WEB_PORT=8787

# --- 公网部署（密码 + 手机验证器 TOTP 登录；本机自用别开） ---
# 生成方法：python reset_auth.py -p "你的密码"（或 auth_setup.py 交互式）
# WEB_AUTH_ENABLED=off            # on = 未登录一律跳 /login；本机自用时保持 off
# WEB_AUTH_PASS_HASH=             # pbkdf2 密码哈希，用 reset_auth.py 生成，别存明文
# WEB_AUTH_TOTP_SECRET=           # base32 密钥，验证器 App 扫码/手动输入用
# WEB_AUTH_SESSION_SECRET=        # 64 位随机 hex，签名 cookie 用；换了所有人被登出
# WEB_AUTH_COOKIE_SECURE=on       # HTTPS 才安全；纯 HTTP 设 off（不推荐）
# 安全要点：连续错 5 次锁 10 分钟；密码不要低于 12 位；
# 公网部署务必 WEB_HOST=127.0.0.1，只让 nginx 反代（否则明文 HTTP 会绕过 HTTPS 截获密码）
