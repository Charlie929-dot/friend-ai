WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_USER_ID=

# --- Telegram 兜底通道（telegram 模式必填） ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

