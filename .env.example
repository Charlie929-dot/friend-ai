# 复制为 .env 并填写。不要提交 .env 到 git。

# --- DeepSeek（必填，否则回复为 stub） ---
DEEPSEEK_API_KEY=

# --- 企业微信自建应用（server 模式必填） ---
WECOM_CORPID=
WECOM_CORPSECRET=
