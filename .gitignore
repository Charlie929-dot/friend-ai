# 隐私与密钥
.env
profile.md

# 数据（聊天记录/记忆库）
*.db
*.db-journal
# 测试跑出来的临时目录（里面是临时 friend.db 等产物）
tmp*/
.test-tmp/
backups/
archive.log
outbox.log
*.log

# 表情包池（用户新增的桶/表情 + 表情图，运行时数据不进 git）
emoji_pool.json
emoji_images/

# 用户导入的电子书（不进 git，只留 README 说明）
books/*
!books/README.txt

# 订阅源列表（运行时数据：网页端/命令改它，sync-to-server 的 git checkout 会冲掉；
# 出厂种子在 sources.py 的 DEFAULT_SOURCES）
sources.txt

# 本地 embedding 模型（bge-small-zh-v1.5 ONNX，约 100MB，不进 git；
# 首次同步时由 sync-to-server.sh 自动下载到 models/）
models/

# 常驻守护的运行时产物（PID / 停止标志）
*.pid
web.stop

# Python
__pycache__/
*.pyc
.venv/

# IDE
.idea/

# AGENTS.md
AGENTS.md

# JiuwenSwarm runtime file operation logs
.agent_history/
